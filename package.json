{
  "name": "koko-sdk",
  "version": "0.2.0",
  "description": "TypeScript CDP SDK for Koko — connect, launch, profile, and agent APIs over WebSocket.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./driver": {
      "types": "./dist/driver.d.ts",
      "import": "./dist/driver.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./workflow": {
      "types": "./dist/workflow.d.ts",
      "import": "./dist/workflow.js"
    },
    "./cdp": {
      "types": "./dist/cdp/client.d.ts",
      "import": "./dist/cdp/client.js"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "import": "./dist/profile.js"
    }
  },
  "bin": {
    "koko-fetch": "dist/cli/fetch.js"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "CHANGELOG.md",
    "tsconfig.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivanUri/koko-sdk.git"
  },
  "homepage": "https://kokoio.com",
  "bugs": {
    "url": "https://github.com/ivanUri/koko-sdk/issues"
  },
  "keywords": [
    "koko",
    "cdp",
    "chrome-devtools-protocol",
    "browser-automation",
    "playwright",
    "web-scraping",
    "antidetect"
  ],
  "license": "MIT",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "smoke:chrome": "npm run build && node scripts/smoke-chrome-driver.mjs",
    "prepublishOnly": "npm run build",
    "example:crawl": "node examples/crawl-wikipedia.mjs --launch --limit 8 --concurrency 2",
    "example:agent": "node examples/agent-semantic.mjs --launch",
    "example:dump": "node examples/dump-markdown.mjs https://example.com"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
